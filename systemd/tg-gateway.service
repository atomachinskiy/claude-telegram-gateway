[Unit]
Description=tg-gateway (reliable Telegram transport for Claude Code)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs the prebuilt node bundle (no bun needed on the client). The bot token and
# owner are read from gateway.env in the state dir (written by `pair`).
ExecStart=/usr/bin/env node %h/tg-gateway/gateway/dist/gateway.js
Restart=always
RestartSec=2
MemoryMax=400M
Environment=TELEGRAM_STATE_DIR=%h/.claude/channels/tg-gateway
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
